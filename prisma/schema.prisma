generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuthConfig {
  id            String   @id
  passwordHash  String
  salt          String
  sessionSecret String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model PortfolioCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PortfolioItem[]
}

model PortfolioItem {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  location    String?
  date        DateTime?
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  order       Int       @default(0)
  tags        String?
  imageSrc    String
  watermark   String    @default("NONE")
  categoryId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category PortfolioCategory? @relation(fields: [categoryId], references: [id])
}

model StoryCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories Story[]
}

model Story {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String?
  readTime       String?
  author         String?
  date           DateTime?
  status         String    @default("DRAFT")
  featured       Boolean   @default(false)
  order          Int       @default(0)
  tags           String?
  imageSrc       String
  categoryId     String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category StoryCategory? @relation(fields: [categoryId], references: [id])
}

model VideoCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]
}

model Video {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  vimeoUrl     String?
  vimeoId      String?
  duration     String?
  date         DateTime?
  status       String    @default("DRAFT")
  featured     Boolean   @default(false)
  order        Int       @default(0)
  thumbnailSrc String
  categoryId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category VideoCategory? @relation(fields: [categoryId], references: [id])
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  notes     String?
  language  String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums ClientAlbum[]
}

model ClientAlbum {
  id                    String    @id @default(cuid())
  title                 String
  slug                  String    @unique
  description           String?
  coverSrc              String?
  shootingDate          DateTime?
  location              String?
  status                String    @default("DRAFT")
  order                 Int       @default(0)
  passwordHash          String?
  allowDownload         Boolean   @default(false)
  allowShare            Boolean   @default(true)
  externalDownloadUrl   String?
  externalDownloadLabel String?
  expiresAt             DateTime?
  clientId              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client Client?            @relation(fields: [clientId], references: [id])
  images ClientAlbumImage[]
}

model ClientAlbumImage {
  id        String   @id @default(cuid())
  albumId   String
  imageSrc  String
  title     String?
  alt       String?
  order     Int      @default(0)
  watermark String   @default("NONE")
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album ClientAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model PageContent {
  id         String   @id @default(cuid())
  pageKey    String
  sectionKey String
  content    Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([pageKey, sectionKey])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String?
  email       String?
  projectType String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model NewsletterCampaign {
  id             String    @id @default(cuid())
  title          String
  subject        String
  previewText    String?
  heroImage      String?
  body           String
  ctaLabel       String?
  ctaHref        String?
  status         String    @default("DRAFT")
  recipientCount Int       @default(0)
  sentAt         DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model BlobImageOptimization {
  id                     String    @id @default(cuid())
  url                    String    @unique
  pathname               String
  uploadedAt             DateTime?
  storedSize             Float     @default(0)
  contentType            String?
  contentHash            String?
  format                 String?
  width                  Int?
  height                 Int?
  projectedSize          Float?
  projectedSavingBytes   Float     @default(0)
  projectedSavingPercent Float     @default(0)
  policyIssues           Json?
  status                 String    @default("UNKNOWN")
  policyVersion          Int       @default(0)
  referenced             Boolean   @default(false)
  presentInStorage       Boolean   @default(true)
  note                   String?
  checkedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([presentInStorage, status, policyVersion])
  @@index([presentInStorage, uploadedAt])
  @@index([referenced])
  @@index([contentHash])
}
